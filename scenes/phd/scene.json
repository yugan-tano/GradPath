      { "title": "整理目标院校与导师清单", "scope": "选校", "due_date": "", "priority": "高", "status": "待办", "note": "按研究方向筛选合适的课题组。" },
      { "title": "准备研究计划与套磁信", "scope": "套磁", "due_date": "", "priority": "高", "status": "待办", "note": "针对每位导师个性化套磁。" },
      { "title": "核对各校申请截止日期", "scope": "申请", "due_date": "", "priority": "中", "status": "待办", "note": "建立截止时间表，避免遗漏。" }
    ],
    "questions": [
      { "topic": "自我介绍", "question": "请用 1-3 分钟介绍你自己。", "answer": "", "tag": "通用" },
