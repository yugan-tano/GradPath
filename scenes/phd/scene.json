    ],
    "english": [
      { "exam_type": "雅思 IELTS", "target_total": 6.5, "current_total": 0, "listening": 0, "reading": 0, "writing": 0, "speaking": 0, "test_date": "", "status": "未开始", "note": "" }
    ]
  },
  "checklists": {
    "phd_contact": {
      "owner": "global",
      "items": ["确定目标院校与导师", "研读目标导师论文与方向", "准备个性化套磁信", "发送套磁信并跟进"],
      "itemsEn": ["Shortlist target schools & professors", "Read target professors' papers", "Prepare personalized contact emails", "Send & follow up on contact emails"]
    },
    "phd_materials": {
      "owner": "global",
      "items": ["更新简历与个人陈述", "准备成绩单与学位证明", "撰写研究计划", "准备推荐信与导师联系"],
      "itemsEn": ["Update CV & personal statement", "Prepare transcripts & degree certificates", "Write the research proposal", "Arrange recommendation letters"]
    },
    "phd_apply": {
      "owner": "global",
      "items": ["核对各校申请截止时间", "填写网申系统", "上传申请材料", "确认提交并记录状态"],
      "itemsEn": ["Confirm application deadlines", "Complete the online application", "Upload all materials", "Submit & track status"]
    },
    "phd_interview": {
      "owner": "global",
      "items": ["准备自我介绍与研究介绍", "梳理项目细节与贡献", "准备导师与方向相关问题", "完成面试并复盘"],
      "itemsEn": ["Prepare self-intro & research talk", "Organize project details & contributions", "Prepare professor & direction questions", "Complete interviews & review"]
    }
  },
  "acts": [
    {
      "id": "phd",
      "name": "申博 SOP",
      "nameEn": "PhD Application SOP",
      "stages": [
        { "id": "p_contact", "name": "选校与套磁", "nameEn": "Selection & Contact", "checklist": "phd_contact", "exit": { "op": "checklist", "checklist": "phd_contact", "target": 1.0 } },
        { "id": "p_materials", "name": "材料准备", "nameEn": "Materials", "checklist": "phd_materials", "enter": { "op": "stageDone", "stage": "p_contact" }, "exit": { "op": "checklist", "checklist": "phd_materials", "target": 1.0 } },
        { "id": "p_apply", "name": "提交申请", "nameEn": "Submission", "checklist": "phd_apply", "enter": { "op": "stageDone", "stage": "p_materials" }, "exit": { "op": "checklist", "checklist": "phd_apply", "target": 1.0 } },
        { "id": "p_interview", "name": "面试考核", "nameEn": "Interview", "checklist": "phd_interview", "enter": { "op": "stageDone", "stage": "p_apply" }, "exit": { "op": "checklist", "checklist": "phd_interview", "target": 1.0 } },
        { "id": "p_decision", "name": "录取决策", "nameEn": "Decision", "enter": { "op": "stageDone", "stage": "p_interview" } }
      ]
    }
  ],
  "templates": [],
  "timeline": []
}
